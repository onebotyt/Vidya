{
  "name": "vidya-institutional-system",
  "version": "1.0.0",
  "description": "VidyaOS — Institutional Campus & Academic Operating System",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File deployfolder/start-all.ps1",
    "start:updated": "powershell -ExecutionPolicy Bypass -File deployfolder/start-all.ps1",
    "start:backend": "cd deployfolder/VidyaOS_BackEnd && node server.js",
    "start:frontend": "cd deployfolder/VidyaOS && node server.js",
    "start:old": "cd backend && node server.js",
    "collab:pull": "node scripts/collab/pull-dev2.js",
    "collab:diff": "node scripts/collab/diff-dev2.js",
    "collab:apply": "node scripts/collab/apply-dev2.js",
    "collab:preview": "node scripts/collab/preview-server.js",
    "push": "powershell -ExecutionPolicy Bypass -File scripts/auto-push.ps1",
    "push:safe": "node scripts/collab/safe-push.js",
    "push:backend": "node scripts/collab/safe-push.js",
    "test:theme": "node backend/scripts/test-theme-support.js",
    "test:rbac": "node backend/scripts/test-rbac-and-structure.js",
    "verify:components": "node scripts/verify-components-only.js",
    "verify:components:admin": "node scripts/verify-components-only.js --role admin",
    "verify:components:faculty-student": "node scripts/verify-components-only.js --role faculty-student",
    "ui:backup": "node scripts/ui-backup-revert.js backup",
    "ui:revert": "node scripts/ui-backup-revert.js revert",
    "ui:status": "node scripts/ui-backup-revert.js status"
  },
  "author": "Vidya Engineering",
  "license": "ISC"
}

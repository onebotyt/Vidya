{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://vidyaos-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://vidyaos-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/shared/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/shared/js/:path*"
    },
    {
      "source": "/shared/:path*",
      "destination": "/frontend/shared/:path*"
    },
    {
      "source": "/login",
      "destination": "/frontend/login/index.html"
    },
    {
      "source": "/login/",
      "destination": "/frontend/login/index.html"
    },
    {
      "source": "/register",
      "destination": "/frontend/login/register"
    },
    {
      "source": "/register/",
      "destination": "/frontend/login/register"
    },
    {
      "source": "/register.html",
      "destination": "/frontend/login/register"
    },
    {
      "source": "/login/register.html",
      "destination": "/frontend/login/register"
    },
    {
      "source": "/login/student-register.html",
      "destination": "/frontend/login/register?role=student"
    },
    {
      "source": "/login/faculty-register.html",
      "destination": "/frontend/login/register?role=faculty"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin/academic-structure"
    },
    {
      "source": "/admin/departments",
      "destination": "/frontend/admin/academic-structure?tab=departments"
    },
    {
      "source": "/faculty",
      "destination": "/frontend/faculty/dashboard"
    },
    {
      "source": "/faculty/analytics",
      "destination": "/frontend/faculty/reports?tab=analytics"
    },
    {
      "source": "/faculty/marks",
      "destination": "/frontend/faculty/tests"
    },
    {
      "source": "/faculty/attendance/quick",
      "destination": "/frontend/faculty/registers"
    },
    {
      "source": "/student",
      "destination": "/frontend/student/dashboard"
    },
    {
      "source": "/student/attendance/subjects",
      "destination": "/frontend/student/attendance"
    },
    {
      "source": "/:section/:page.css",
      "destination": "/frontend/:section/:page/:page.css"
    },
    {
      "source": "/:section/:page.js",
      "destination": "/frontend/:section/:page/:page.js"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}
